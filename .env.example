# Optional. Use: node --env-file=.env server.js
HOST=127.0.0.1
PORT=8787
MEMORY_DATA_DIR=./data
# Optional Supabase/Postgres storage. When set, durable records use Postgres and
# MEMORY_DATA_DIR is only temporary runtime/cache storage.
# Use the Session Pooler URL for this long-lived Render service.
# MEMORY_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
# MEMORY_DATABASE_POOL_SIZE=3
# Stable non-secret installation identifier. Set this on stateless hosting.
# MEMORY_SOURCE_ID=
# Headless deployments may supply a management token instead of browser setup.
# MEMORY_ADMIN_TOKEN=
# Comma-separated origins for browser frontends hosted on another domain.
# MEMORY_ALLOWED_ORIGINS=https://your-frontend.example
